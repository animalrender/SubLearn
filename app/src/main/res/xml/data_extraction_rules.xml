<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="." />
        <exclude domain="sharedpref" path="sublearn_secrets.preferences_pb" />
        <exclude domain="database" path="sublearn.db" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="." />
        <include domain="database" path="sublearn.db" />
        <exclude domain="sharedpref" path="sublearn_secrets.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
