<?xml version="1.0" encoding="utf-8"?>
<!-- API 31+ rules; same policy as backup_rules.xml for cloud backup and device-to-device transfer:
     DataStore settings and the Room database go, the Keystore-wrapped secrets do not (D-14). -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="datastore" />
        <exclude domain="file" path="datastore/sublearn_secrets.preferences_pb" />
        <include domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="datastore" />
        <exclude domain="file" path="datastore/sublearn_secrets.preferences_pb" />
        <include domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
