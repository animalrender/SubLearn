<resources>
    <!-- API 27 added display-cutout control; the player draws edge to edge under the notch. The
         base style in values/themes.xml is identical minus this item (styles do not merge). -->
    <style name="Theme.SubLearn.Player" parent="Theme.SubLearn">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
